kraken_host_launcher/profiles/
# logi i cache tras
kraken_host_launcher/logs/
kraken_host_launcher/route_cache/
# konfiguracje postaci zawierają loginy i HASŁA do kont gry
kraken_host_launcher/config/*.json
kraken_host_launcher/config/*.lock
# webhook Discorda (wzór: alert/discord.example.json)
kraken_host_launcher/alert/discord.json

# ── kraken_user_client: lokalne pliki robocze ──
