{
  "name": "basic_farm",
  "description": "Farmowanie tolloki — Skalne Turnie + Skarpiska Tolloków (45lvl)",
  "steps": [
    {
      "action": "solve_captcha",
      "params": { "action": "immediately" }
    },
    {
      "action": "navigate_to",
      "params": { "location": "Skalne Turnie" }
    },
    {
      "loop": {
        "steps": [
          {
            "action": "wait",
            "params": { "seconds": 1.5 },
            "comment": "czekaj na załadowanie mapy po nawigacji"
          },
          {
            "loop": {
              "stop_when": { "$targets": "empty" },
              "sleep_s": 0.1,
              "steps": [
                {
                  "action": "find_object",
                  "params": { "type": ["mmp-mob"] },
                  "save_as": "targets"
                },
                {
                  "action": "kill_object",
                  "params": { "targets": "$targets" },
                  "skip_when": { "$targets": "empty" }
                }
              ]
            }
          },
          {
            "action": "navigate_to",
            "params": { "location": "Skarpiska Tolloków" }
          },
          {
            "action": "wait",
            "params": { "seconds": 1.5 }
          },
          {
            "loop": {
              "stop_when": { "$targets": "empty" },
              "sleep_s": 0.1,
              "steps": [
                {
                  "action": "find_object",
                  "params": { "type": ["mmp-mob"] },
                  "save_as": "targets"
                },
                {
                  "action": "kill_object",
                  "params": { "targets": "$targets" },
                  "skip_when": { "$targets": "empty" }
                }
              ]
            }
          },
          {
            "action": "navigate_to",
            "params": { "location": "Skalne Turnie" }
          }
        ]
      }
    }
  ]
}
