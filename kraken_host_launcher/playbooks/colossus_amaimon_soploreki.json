{
  "name": "colossus_amaimon_soploreki",
  "description": "Amaimon Soploręki (83lvl) — pełny pipeline kolos zgodnie z diagramem",

  "context_init": {
    "role": "follower"
  },

  "steps": [
    { "action": "check_role", "save_as": "role" },

    {
      "loop": {
        "stop_when": { "$_done": "true" },
        "steps": [

          { "set": { "_fight_ready": null, "_afk_ready": null, "_group_now": null } },

          {
            "action": "check_colossus_done",
            "params": { "exit_location": "Skały Mroźnych Śpiewów" },
            "save_as": "_kolos_done",
            "skip_when": { "$kolos_repeat": "not_empty" }
          },
          {
            "if": { "$_kolos_done": "true" },
            "then": [
              { "action": "play", "params": { "playbook": "afk.json" } },
              { "set": { "_done": "true" } }
            ]
          },

          { "action": "wait",          "params": { "seconds": 10 } },
          { "action": "solve_captcha", "params": { "action": "immediately" } },
          { "action": "anti_afk" },

          {
            "action": "navigate_to",
            "params": {
              "location": "Zmarzlina Amaimona Soplorękiego - przedsionek",
              "timeout_s": 120
            }
          },

          {
            "action": "move_to",
            "params": {
              "position": { "top": 153.125, "left": 306.25 },
              "timeout_s": 30
            }
          },
          { "action": "solve_captcha", "params": { "action": "immediately" } },

          {
            "if": { "$role": "eq:leader" },

            "then": [

              {
                "loop": {
                  "stop_when": { "$_afk_ready": "true" },
                  "steps": [
                    {
                      "action": "make_group",
                      "params": {
                        "party_size": 10,
                        "gather_key": "g",
                        "gather_interval_s": 10,
                        "position": { "top": 153.125, "left": 306.25 },
                        "timeout_s": 300
                      },
                      "save_as": "_party_size"
                    },
                    { "action": "wait", "params": { "seconds": 10 } },
                    {
                      "action": "check_afk_members",
                      "params": { "party_size": 10 },
                      "save_as": "_afk_ready"
                    }
                  ]
                }
              },

              {
                "action": "navigate_to",
                "params": {
                  "location": "Zmarzlina Amaimona Soplorękiego - sala",
                  "timeout_s": 120
                }
              },
              { "action": "check_group_size", "save_as": "_group_now" },
              {
                "if": { "$_group_now": "lt:2" },
                "then": [
                  {
                    "action": "navigate_to",
                    "params": {
                      "location": "Zmarzlina Amaimona Soplorękiego - przedsionek",
                      "timeout_s": 120
                    }
                  }
                ],
                "else": [
                  {
                    "if": { "$kolos_repeat": "not_empty" },
                    "then": [ { "action": "use_repeat_entry" } ]
                  },
                  { "action": "wait",          "params": { "seconds": 15 } },
                  { "action": "solve_captcha", "params": { "action": "immediately" } },

                  {
                    "action": "checkout_group",
                    "params": { "party_size": 10 },
                    "save_as": "_current_size"
                  },

                  {
                    "action": "move_to",
                    "params": {
                      "position": { "top": 240.625, "left": 371.875 },
                      "timeout_s": 30
                    }
                  },
                  { "action": "solve_captcha", "params": { "action": "immediately" } },
                  { "action": "wait",          "params": { "seconds": 10 } },

                  {
                    "action": "attack_colossus",
                    "params": { "colossus_class": "mmp-collosus" },
                    "save_as": "_attacked"
                  },
                  { "action": "quick_fight" },

                  { "set": { "_fight_ready": "yes" } }
                ]
              }
            ],

            "else": [

              {
                "action": "wait_group",
                "params": {
                  "min_size": 5,
                  "position": { "top": 153.125, "left": 306.25 },
                  "timeout_s": 600
                },
                "save_as": "_group_size"
              },

              {
                "if": { "$_group_size": "gte:5" },
                "then": [
                  {
                    "action": "navigate_to",
                    "params": {
                      "location": "Zmarzlina Amaimona Soplorękiego - sala",
                      "timeout_s": 120
                    }
                  },
                  { "action": "check_group_size", "save_as": "_group_now" },
                  {
                    "if": { "$_group_now": "lt:2" },
                    "then": [
                      {
                        "action": "navigate_to",
                        "params": {
                          "location": "Zmarzlina Amaimona Soplorękiego - przedsionek",
                          "timeout_s": 120
                        }
                      }
                    ],
                    "else": [
                      {
                        "if": { "$kolos_repeat": "not_empty" },
                        "then": [ { "action": "use_repeat_entry" } ]
                      },
                      { "action": "solve_captcha", "params": { "action": "immediately" } },

                      {
                        "action": "move_to",
                        "params": {
                          "position": { "top": 240.625, "left": 371.875 },
                          "timeout_s": 30
                        }
                      },
                      { "action": "solve_captcha", "params": { "action": "immediately" } },

                      { "set": { "_fight_ready": "yes" } }
                    ]
                  }
                ]
              }
            ]
          },

          {
            "action": "wait_battle",
            "params": {
              "timeout_s": 600,
              "fight_position": { "top": 240.625, "left": 371.875 }
            },
            "save_as": "_battle_ready",
            "skip_when": { "$_fight_ready": "empty" }
          },

          {
            "action": "watch_battle",
            "params": {
              "colossus_class": "mmp-collosus",
              "attack_key": "f",
              "timeout_s": 3600
            },
            "save_as": "fight_result",
            "skip_when": { "$_fight_ready": "empty" }
          },

          {
            "if": { "$_fight_ready": "not_empty" },
            "then": [
              {
                "if": { "$fight_result": "eq:win" },
                "then": [
                  {
                    "action": "end_battle",
                    "params": { "exit_location": "Skały Mroźnych Śpiewów" }
                  },
                  { "action": "play", "params": { "playbook": "afk.json" } },
                  { "set": { "_done": "true" } }
                ],
                "else": [
                  { "action": "end_battle",  "params": { "timeout_s": 15 } },
                  { "action": "wait_death",  "params": { "timeout_s": 300 } },
                  {
                    "if": { "$role": "eq:leader" },
                    "then": [ { "action": "disband_group" } ]
                  }
                ]
              }
            ]
          }

        ]
      }
    }
  ]
}
